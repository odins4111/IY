              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init report poll variables" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">if (vars.get(&quot;reportState&quot;) == null || vars.get(&quot;reportState&quot;).equals(&quot;&quot;)) vars.put(&quot;reportState&quot;, &quot;0&quot;);
if (vars.get(&quot;reportPollCount&quot;) == null || vars.get(&quot;reportPollCount&quot;).equals(&quot;&quot;)) vars.put(&quot;reportPollCount&quot;, &quot;0&quot;);
if (vars.get(&quot;reportIdBeforeBuild&quot;) == null || vars.get(&quot;reportIdBeforeBuild&quot;).equals(&quot;&quot;)) vars.put(&quot;reportIdBeforeBuild&quot;, &quot;0&quot;);
if (vars.get(&quot;userReportId&quot;) == null || vars.get(&quot;userReportId&quot;).equals(&quot;&quot;)) vars.put(&quot;userReportId&quot;, &quot;NOT_FOUND&quot;);
log.info(&quot;Poll init: maxId=&quot; + vars.get(&quot;reportIdBeforeBuild&quot;) + &quot; state=&quot; + vars.get(&quot;reportState&quot;) + &quot; count=&quot; + vars.get(&quot;reportPollCount&quot;));
SampleResult.setResponseData(&quot;reportState=&quot; + vars.get(&quot;reportState&quot;) + &quot;, reportPollCount=&quot; + vars.get(&quot;reportPollCount&quot;), &quot;UTF-8&quot;);</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Sampler>
              <hashTree/>
