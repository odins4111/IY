                  <stringProp name="TestPlan.comments">Poll until report state becomes 2 (ready). Short timeouts: 10s connect / 20s response.</stringProp>
                  <intProp name="HTTPSampler.connect_timeout">10000</intProp>
                  <intProp name="HTTPSampler.response_timeout">20000</intProp>
                  <stringProp name="HTTPSampler.domain">${api_domain}</stringProp>
                  <stringProp name="HTTPSampler.protocol">https</stringProp>
                  <stringProp name="HTTPSampler.path">/userreport/list</stringProp>
