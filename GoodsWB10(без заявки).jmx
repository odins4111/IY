                <hashTree>
                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Find new report in list and read state" enabled="true">
                    <stringProp name="scriptLanguage">beanshell</stringProp>
                    <stringProp name="cacheKey">false</stringProp>
                    <stringProp name="script">import java.util.regex.*;
if (&quot;401&quot;.equals(prev.getResponseCode())) {
    vars.put(&quot;reportPollCount&quot;, &quot;5&quot;);
    log.warn(&quot;Report poll got 401 Unauthorized (token expired?), stopping poll.&quot;);
} else {
    String resp = prev.getResponseDataAsString();
    String targetId = vars.get(&quot;userReportId&quot;);
    String state = vars.get(&quot;reportState&quot;);
    if (state == null || state.equals(&quot;&quot;)) state = &quot;0&quot;;
    int before = 0;
    try { before = Integer.parseInt(vars.get(&quot;reportIdBeforeBuild&quot;)); } catch (Exception ignored) {}
    String q = &quot;\&quot;&quot;;
    Pattern itemPat = Pattern.compile(q + &quot;id&quot; + q + &quot;\\s*:\\s*(\\d+)[\\s\\S]*?&quot; + q + &quot;state&quot; + q + &quot;\\s*:\\s*(\\d+)&quot;);
    Matcher m = itemPat.matcher(resp);
    int bestNewId = -1;
    String bestNewState = null;
    boolean foundTarget = false;
    while (m.find()) {
        int id = Integer.parseInt(m.group(1));
        String st = m.group(2);
        if (targetId != null &amp;&amp; !targetId.equals(&quot;&quot;) &amp;&amp; !&quot;NOT_FOUND&quot;.equals(targetId)) {
            if (targetId.equals(String.valueOf(id))) {
                state = st;
                foundTarget = true;
                break;
            }
        } else if (id &gt; before &amp;&amp; id &gt; bestNewId) {
            bestNewId = id;
            bestNewState = st;
        }
    }
    if (!foundTarget &amp;&amp; (targetId == null || targetId.equals(&quot;&quot;) || &quot;NOT_FOUND&quot;.equals(targetId)) &amp;&amp; bestNewId &gt; 0) {
        vars.put(&quot;userReportId&quot;, String.valueOf(bestNewId));
        state = bestNewState;
    }
    vars.put(&quot;reportState&quot;, state);
    int c = 0;
    try { c = Integer.parseInt(vars.get(&quot;reportPollCount&quot;)); } catch (Exception ignored) {}
    vars.put(&quot;reportPollCount&quot;, String.valueOf(c + 1));
    if (c + 1 &gt;= 5 &amp;&amp; !&quot;2&quot;.equals(state)) {
        log.warn(&quot;Report not ready after 5 polls, skipping download. id=&quot; + vars.get(&quot;userReportId&quot;) + &quot; state=&quot; + state);
    }
    log.info(&quot;Report poll #&quot; + vars.get(&quot;reportPollCount&quot;) + &quot; id=&quot; + vars.get(&quot;userReportId&quot;) + &quot; state=&quot; + vars.get(&quot;reportState&quot;));
}</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                  </JSR223PostProcessor>
                  <hashTree/>
                </hashTree>
