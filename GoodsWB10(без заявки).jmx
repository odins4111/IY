                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare save variables">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.util.UUID;

String[][] tik = {
    {&quot;temporaryIdentityKey&quot;, &quot;tempKey_main&quot;},
    {&quot;temporaryIdentityKey_1815&quot;, &quot;tempKey_1815&quot;},
    {&quot;temporaryIdentityKey_1816&quot;, &quot;tempKey_1816&quot;}
};

for (int i = 0; i &lt; tik.length; i++) {
    String v = vars.get(tik[i][0]);
    if (v == null || v.equals(&quot;&quot;) || v.equals(&quot;NOT_FOUND&quot;)) {
        String fb = vars.get(tik[i][1]);
        if (fb != null &amp;&amp; !fb.equals(&quot;&quot;)) {
            vars.put(tik[i][0], fb);
        } else {
            // Генерируем UUID если нет значения
            vars.put(tik[i][0], UUID.randomUUID().toString());
        }
    }
}

// Генерация кода если не задан
String code = vars.get(&quot;code&quot;);
if (code == null || code.equals(&quot;&quot;) || code.equals(&quot;NOT_FOUND&quot;)) {
    vars.put(&quot;code&quot;, &quot;LT&quot; + UUID.randomUUID().toString().substring(0, 8));
}

// Генерация числовых значений
String[] numKeys = {&quot;mainEntityId&quot;, &quot;itemVersionId&quot;, &quot;entityId_1815&quot;, &quot;entityId_1816&quot;};
for (int i = 0; i &lt; numKeys.length; i++) {
    String v = vars.get(numKeys[i]);
    if (v == null || v.equals(&quot;&quot;) || v.equals(&quot;NOT_FOUND&quot;)) {
        vars.put(numKeys[i], &quot;0&quot;);
    }
}

// Убедимся, что currentUserId - это число
String userId = vars.get(&quot;currentUserId&quot;);
if (userId == null || userId.equals(&quot;&quot;) || userId.equals(&quot;NOT_FOUND&quot;)) {
    vars.put(&quot;currentUserId&quot;, &quot;35&quot;); // или любое другое значение по умолчанию
}</stringProp>
                </JSR223PreProcessor>
