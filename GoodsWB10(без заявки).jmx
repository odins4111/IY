              <hashTree>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract first linked entity id" enabled="true">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.util.regex.*;
String label = prev.getSampleLabel();
int target = label.contains(&quot;[2]&quot;) &amp;&amp; label.contains(&quot;/1324/&quot;) ? 2 : 1;
String varName = null;
if (label.contains(&quot;/1325/&quot;)) varName = &quot;linkedId_1325&quot;;
else if (label.contains(&quot;/1323/&quot;)) varName = &quot;linkedId_1323&quot;;
else if (label.contains(&quot;/19/&quot;)) varName = &quot;linkedId_19&quot;;
else if (label.contains(&quot;/16/&quot;)) varName = &quot;linkedId_16&quot;;
else if (label.contains(&quot;/1321/&quot;)) varName = &quot;linkedId_1321&quot;;
else if (label.contains(&quot;/1322/&quot;)) varName = &quot;linkedId_1322&quot;;
else if (label.contains(&quot;/1324/&quot;)) varName = label.contains(&quot;[2]&quot;) ? &quot;linkedId_1324_2&quot; : &quot;linkedId_1324&quot;;
else if (label.contains(&quot;/1319/&quot;)) varName = &quot;linkedId_1319&quot;;
if (varName != null) {
    String resp = prev.getResponseDataAsString();
    String q = &quot;\&quot;&quot;;
    Pattern pat = Pattern.compile(q + &quot;entityId&quot; + q + &quot;\\s*:\\s*(\\d+)&quot;);
    Matcher m = pat.matcher(resp);
    int n = 0;
    String val = &quot;0&quot;;
    while (m.find()) {
        String eid = m.group(1);
        if (!&quot;0&quot;.equals(eid)) { n++; if (n == target) { val = eid; break; } }
    }
    if (&quot;0&quot;.equals(val)) {
        m = pat.matcher(resp);
        while (m.find()) { if (!&quot;0&quot;.equals(m.group(1))) { val = m.group(1); break; } }
    }
    vars.put(varName, val);
    log.info(&quot;Extract &quot; + varName + &quot;=&quot; + val + &quot; from &quot; + label);
}</stringProp>
                </JSR223PostProcessor>
