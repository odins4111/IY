                <stringProp name="WhileController.condition">${__jexl3(&quot;2&quot; != &quot;${reportState}&quot; &amp;&amp; ${__intSum(0,${reportPollCount},)} &lt; 5)}</stringProp>
              </WhileController>
              <hashTree>
