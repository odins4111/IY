                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract saved entity id">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="script">import java.util.regex.*;
String resp = prev.getResponseDataAsString();
String id = null;
int pe = resp.indexOf(&quot;processedEntity&quot;);
String search = pe &gt;= 0 ? resp.substring(pe) : resp;
String q = &quot;\&quot;&quot;;
Pattern pat = Pattern.compile(q + &quot;entityId&quot; + q + &quot;\\s*:\\s*(\\d+)&quot;);
Matcher m = pat.matcher(search);
while (m.find()) {
    String v = m.group(1);
    if (!&quot;0&quot;.equals(v)) { id = v; break; }
}
if (id == null) {
    m = pat.matcher(resp);
    while (m.find()) {
        String v = m.group(1);
        if (!&quot;0&quot;.equals(v)) { id = v; break; }
    }
}
if (id != null) {
    vars.put(&quot;savedEntityId&quot;, id);
} else {
    vars.put(&quot;savedEntityId&quot;, &quot;NOT_FOUND&quot;);
}
log.info(&quot;Extract savedEntityId=&quot; + vars.get(&quot;savedEntityId&quot;));</stringProp>
                </JSR223PostProcessor>
